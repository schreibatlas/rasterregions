+def _mask_runs(mask: np.ndarray) -> list[list[int]]:
+    runs: list[list[int]] = []
+    for y, row in enumerate(np.asarray(mask, dtype=bool)):
+        xs = np.flatnonzero(row)
+        if not len(xs):
+            continue
+        start = previous = int(xs[0])
+        for value in xs[1:]:
+            x = int(value)
+            if x != previous + 1:
+                runs.append([y, start, previous + 1])
+                start = x
+            previous = x
+        runs.append([y, start, previous + 1])
+    return runs
+
