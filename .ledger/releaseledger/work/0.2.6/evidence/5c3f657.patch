+    )
+    selected = options[0]
+    limit = config.spacing.hypothesis_limit
+    retained = options[:limit]
+    if all(option is not baseline for option in retained):
+        retained[-1] = baseline
+        retained.sort(
+            key=lambda option: (
+                option.cost,
+                option.repair_count,
